# DowagerMod Chatter — single .env file for sidecar + credential tests.
#
# Setup:
#   1. Copy this file to ".env" in the repo root (C:\DowagerMod\.env)
#   2. Fill in real values below
#   3. Run .\tools\Setup-Chatter.ps1 to validate
#   4. Run .\tools\Start-Chatter.ps1 to start the daemon
#
# The .env file is the SINGLE SOURCE OF TRUTH for chatter configuration.
# There is no config.json anymore. Anything left at
# %LOCALAPPDATA%\DowagerMod\chatter\config.json is legacy and IGNORED.
#
# Security:
#   - .env is gitignored. Keys never go into git history.
#   - Don't share this file. It contains your Azure billing keys + Discord
#     bot identity. If a friend has your .env they can spend on your accounts.
#   - The sidecar daemon writes a heartbeat file every 15 seconds, so
#     don't put .env inside OneDrive-synced folders if you can avoid it.
#
# Precedence: real shell env vars (e.g. `$env:DOWAGER_CHATTER_LOG_LEVEL='DEBUG'`)
# override .env values for one-shot debugging. .env overrides built-in defaults.
# Changes to .env require a daemon restart: Stop-Chatter then Start-Chatter.

# ===== Foundry (text/LLM) =====
DOWAGER_CHATTER_ENDPOINT=https://discordagent.cognitiveservices.azure.com/
DOWAGER_CHATTER_DEPLOYMENT=gpt-5.4-mini
DOWAGER_CHATTER_API_KEY=paste-your-foundry-key-here
DOWAGER_CHATTER_API_VERSION=2024-12-01-preview

# ===== Speech (TTS, optional — enables voiceover) =====
# Endpoint format: https://<region>.tts.speech.microsoft.com/
# NOTE: this is the TTS-specific subdomain — NOT the generic Cognitive Services
# URL shown on the resource's "Keys and Endpoint" portal page. The portal shows
# https://<region>.api.cognitive.microsoft.com/ which 404s on TTS calls.
# Common regions: eastus, westus, westus2, westeurope, northeurope.
DOWAGER_CHATTER_SPEECH_ENDPOINT=https://eastus.tts.speech.microsoft.com/
DOWAGER_CHATTER_SPEECH_KEY=paste-your-speech-key-here
# Default fallback voice for unmapped leaders (per-leader map handles known leaders).
DOWAGER_CHATTER_SPEECH_VOICE=en-US-AriaNeural
# Hard daily char cap so a runaway loop can't accidentally rack up Azure spend.
DOWAGER_CHATTER_VOICEOVER_DAILY_CHAR_CAP=100000

# ===== Discord bot (required for voiceover) =====
DOWAGER_CHATTER_DISCORD_BOT_TOKEN=paste-your-bot-token-here
DOWAGER_CHATTER_DISCORD_GUILD_ID=paste-your-server-id-here
DOWAGER_CHATTER_DISCORD_VOICE_CHANNEL_ID=paste-your-voice-channel-id-here

# ===== Master switch =====
# Set true ONLY when all the voiceover fields above are populated.
# When false, voiceover is fully disabled and only text chatter runs.
DOWAGER_CHATTER_VOICEOVER_ENABLED=false

# ===== Native-tongue mode (optional) =====
# When true, the LLM also generates a translation of each chatter line into
# the speaker's actual language (German for Bismarck, Russian for Catherine,
# Mongolian for Genghis Khan, etc). The Discord bot speaks the native version;
# in-game text remains English (acts as subtitles). Requires gpt-5.4 (full,
# not mini) for good translation quality on rare languages. Leaders without
# a configured 'lang' field in leader_voices.json stay English even when this
# is on.
DOWAGER_CHATTER_NATIVE_TONGUE_MODE=false

# ===== ElevenLabs (optional per-leader override; Azure remains fallback) =====
# When the API key is empty, ElevenLabs is disabled and every leader uses
# Azure Speech exactly as before. When set, leaders whose entry in
# leader_voices.json carries "tts_provider": "elevenlabs" (currently just
# the Dowager Countess) try ElevenLabs first and silently fall back to
# Azure on any failure (auth, quota, network, timeout, 5xx).
#
# Get a key at https://elevenlabs.io/app/settings/api-keys
# Find your voice ID at https://elevenlabs.io/app/voice-lab
#
# Model choices (you can A/B with `python -m tools.chatter.audition_elevenlabs`):
#   eleven_flash_v2_5      - cheapest (0.5 credits/char), lowest latency. Default.
#   eleven_turbo_v2_5      - 0.5 credits/char, very similar quality to flash.
#   eleven_multilingual_v2 - 1.0 credit/char, best for non-English voices.
DOWAGER_CHATTER_ELEVENLABS_API_KEY=
DOWAGER_CHATTER_ELEVENLABS_VOICE_ID_DOWAGER=
DOWAGER_CHATTER_ELEVENLABS_MODEL=eleven_flash_v2_5
# DOWAGER_CHATTER_ELEVENLABS_ENDPOINT=https://api.elevenlabs.io
# DOWAGER_CHATTER_ELEVENLABS_TIMEOUT_SECONDS=20
# DOWAGER_CHATTER_ELEVENLABS_DAILY_CHAR_CAP=0     # 0 = no cap; the API itself rate-limits
# DOWAGER_CHATTER_ELEVENLABS_FAILURE_THRESHOLD=2  # trip circuit after N consecutive failures
# DOWAGER_CHATTER_ELEVENLABS_COOLDOWN_SECONDS=600 # circuit-open duration before retrying

# ===== Local TTS server (optional, highest priority) =====
# When set, leaders with ElevenLabs voices try the local GPU-based TTS
# server first (zero-shot voice cloning via XTTSv2). Falls back to
# ElevenLabs -> Azure on failure. Start the server separately with
# .\tools\Start-TtsServer.ps1.
# DOWAGER_CHATTER_LOCAL_TTS_URL=http://localhost:8080
# DOWAGER_CHATTER_LOCAL_TTS_VOICE_ID_DOWAGER=dowager
# DOWAGER_CHATTER_LOCAL_TTS_TIMEOUT_SECONDS=30.0

# ===== Logging (optional) =====
# DOWAGER_CHATTER_LOG_LEVEL=INFO

# ===== Advanced tunables (optional) =====
# Uncomment and tweak only if you know what you're doing. Defaults are sane.
#
# DOWAGER_CHATTER_MAX_TOKENS=180
# DOWAGER_CHATTER_MAX_TOKENS_MULTI_TURN=320
# DOWAGER_CHATTER_REQUEST_TIMEOUT_SECONDS=8.0
# DOWAGER_CHATTER_RATE_LIMIT_SECONDS=1.5
# DOWAGER_CHATTER_MAX_IN_FLIGHT=4
# DOWAGER_CHATTER_SPOOL_POLL_INTERVAL_SECONDS=0.5
# DOWAGER_CHATTER_REQUEST_TTL_SECONDS=900
# DOWAGER_CHATTER_RESPONSE_TTL_SECONDS=900
# DOWAGER_CHATTER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# DOWAGER_CHATTER_CIRCUIT_BREAKER_OPEN_SECONDS=60

