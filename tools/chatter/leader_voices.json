    ],
    "_realism_notes": {
        "Alexander": "mk-MK voice literally named 'Aleksandar' — Macedonian is the modern descendant of Alexander's homeland",
        "Catherine the Great": "de-DE thick German — she was born German, ruled Russia, and historians note she NEVER lost her German accent at the Russian court",
        "Hannibal": "ar-TN Tunisian Arabic — Carthage was in modern Tunisia. As historically accurate as it gets for a 2200-year-old leader",
        "Genghis Khan": "kk-KZ Kazakh — Azure has no Mongolian neural voice; Kazakh is the closest living Turkic-Mongolic relative",
        "Suryavarman": "km-KH Khmer — he WAS Khmer, ruling the Khmer empire that built Angkor Wat",
        "Ragnar Lothbrok": "is-IS Icelandic — Icelandic is the closest living language to Old Norse; Vikings would basically sound like this",
        "Stalin": "uk-UA Ukrainian — Stalin was Georgian-born but Azure has no Georgian voice. Ukrainian gets closest to Slavic Soviet feel without sharing Peter the Great's Russian voice",
        "Saladin": "ar-SA Saudi Arabic — Saladin ruled Egypt + Syria + Arabian peninsula; Saudi Arabic represents the Arab heartland of his empire",
        "Napoleon": "fr-FR-Yves thick French male — Napoleon famously had a thick Corsican-French accent his whole life. The Yves voice has a slightly older/coarser tone than the courtly Alain (Louis XIV)",
        "Catherine NOT French anymore": "Previous version gave her French (she spoke French at court), but Yves Henri Catherine all spoke fr-FR. de-DE-Katja captures the actual accent she would have had speaking English",
        "Pacal II": "es-MX-Liberto Mexican Spanish — Mayan civilization was in modern southern Mexico/Guatemala",
        "Huayna Capac": "es-PE Peruvian Spanish — the Inca empire was Peru-centered; closest living regional Spanish accent",
        "Frederick the Great": "de-DE-Christoph thick German — austere, disciplined Prussian",
        "Justinian": "it-IT-Gianni — Byzantine emperor whose legal code was in Latin; Italian gives him the imperial-Roman gravitas with a Mediterranean accent",
        "Reginald Endicott Barclay": "en-GB-Elliot — Star Trek nervous nerd. Pure inside-joke pick for the modder Easter egg leader."
    },
