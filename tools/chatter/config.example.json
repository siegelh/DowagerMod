{
  "_comment": "DowagerMod Chatter sidecar example config. Copy to %LOCALAPPDATA%\\DowagerMod\\chatter\\config.json and fill in api_key. Setup-Chatter.ps1 does this interactively.",
  "endpoint": "https://hasiegeltestingfoundry.services.ai.azure.com/openai/v1",
  "deployment": "gpt-5.4-mini",
  "api_key": "",
  "enabled": true,
  "max_tokens": 80,
  "max_tokens_multi_turn": 10000,
  "request_timeout_seconds": 8,
